{
  "name": "photosuite",
  "version": "0.2.0",
  "description": "一款零配置的 Astro 图片增强集成，支持灯箱、自动拼图、EXIF 信息及路径解析。",
  "keywords": [
    "astro-integration",
    "lightbox",
    "exif",
    "gallery",
    "markdown-images",
    "photography",
    "zero-config",
    "灯箱",
    "画廊",
    "自动拼图",
    "图片插件",
    "EXIF"
  ],
  "author": "achuanya",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/achuanya/photosuite"
  },
  "homepage": "https://photosuite.lhasa.icu",
  "bugs": "https://github.com/achuanya/photosuite/issues",
  "type": "module",
  "main": "./dist/photosuite.integration.js",
  "module": "./dist/photosuite.integration.js",
  "types": "./dist/integration.d.ts",
  "exports": {
    ".": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/photosuite.integration.js",
      "require": "./dist/photosuite.integration.cjs"
    },
    "./client": {
      "types": "./dist/index.d.ts",
      "import": "./dist/photosuite.es.js",
      "require": "./dist/photosuite.cjs.js"
    },
    "./dist/photosuite.css": "./dist/photosuite.css"
  },
  "files": [
    "dist",
    "demo/astro.config.mjs",
    "demo/package.json",
    "demo/pnpm-lock.yaml",
    "demo/postcss.config.cjs",
    "demo/tsconfig.json",
    "demo/public",
    "demo/src",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "dev": "pnpm --dir demo dev",
    "build": "tsc && vite build && pnpm --dir demo build",
    "preview": "pnpm --dir demo preview"
  },
  "dependencies": {
    "@fancyapps/ui": "6.1.8",
    "exiftool-vendored": "^35.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "sass": "^1.97.2",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  }
}
